<odoo>

    <!-- HR Module Category (if not already defined) -->
    <record id="module_category_human_resources_exit" model="ir.module.category">
        <field name="name">Employee - Exit - Form</field>
        <field name="description">Employee Exit Form Access</field>
        <field name="sequence">15</field>
    </record>

    <!-- GROUPS (Ordered: User → Dept. Manager → HR → CAO) -->

    <record id="group_exit_form_user" model="res.groups">
        <field name="name">Employee Exit User</field>
        <field name="category_id" ref="module_category_human_resources_exit"/>
    </record>

    <record id="group_exit_form_dept_manager" model="res.groups">
        <field name="name">Employee Exit Dept. Manager</field>
        <field name="category_id" ref="module_category_human_resources_exit"/>
    </record>

    <record id="group_exit_form_hr" model="res.groups">
        <field name="name">Employee Exit HR Approver</field>
        <field name="category_id" ref="module_category_human_resources_exit"/>
    </record>

    <record id="group_exit_form_cao" model="res.groups">
        <field name="name">Employee Exit CAO Approver</field>
        <field name="category_id" ref="module_category_human_resources_exit"/>
    </record>


    <!-- RECORD RULES -->

    <!-- Rule: Employee Exit Users see only their own forms -->
    <record id="exit_form_rule_user_own" model="ir.rule">
        <field name="name">User: See Own Exit Forms</field>
        <field name="model_id" ref="model_hr_employee_exit"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('employee_exit_form.group_exit_form_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Rule: Dept. Manager sees forms where they are the supervisor -->
    <record id="exit_form_rule_dept_manager" model="ir.rule">
        <field name="name">Dept. Manager: Assigned Exit Forms</field>
        <field name="model_id" ref="model_hr_employee_exit"/>
        <field name="domain_force">[('supervisor_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('employee_exit_form.group_exit_form_dept_manager'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Rule: HR Approver sees records assigned to them -->
    <record id="exit_form_rule_hr_approver" model="ir.rule">
        <field name="name">HR: Assigned Exit Forms</field>
        <field name="model_id" ref="model_hr_employee_exit"/>
        <field name="domain_force">[('reporting_to_hr', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('employee_exit_form.group_exit_form_hr'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Rule: CAO Approver sees records assigned to them -->
    <record id="exit_form_rule_cao_approver" model="ir.rule">
        <field name="name">CAO: Assigned Exit Forms</field>
        <field name="model_id" ref="model_hr_employee_exit"/>
        <field name="domain_force">[('reporting_to_cao', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('employee_exit_form.group_exit_form_cao'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Admins have full access -->
    <record id="exit_form_admin_access_rule" model="ir.rule">
        <field name="name">Full Access for Admins</field>
        <field name="model_id" ref="model_hr_employee_exit"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <!-- Multi-company rule -->
    <record model="ir.rule" id="exit_form_company_rule">
        <field name="name">Restricted Exit Form: multi-company</field>
        <field name="model_id" ref="model_hr_employee_exit"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>


    <!-- 2) Dept. Manager rule: can create/write if they are the supervisor on the record -->
    <record id="rule_exit_form_dept_manager_or_hr" model="ir.rule">
        <field name="name">Dept. Manager or HR: Assigned Exit Forms</field>
        <field name="model_id" ref="employee_exit_form.model_hr_employee_exit"/> <!-- Replace -->
        <field name="groups" eval="[(4, ref('employee_exit_form.group_exit_form_dept_manager')),
                                 (4, ref('employee_exit_form.group_exit_form_user'))]"/>
        <field name="domain_force">
            ['|',
            ('supervisor_id.user_id', '=', user.id),
            ('employee_id.user_id', '=', user.id)
            ]
        </field>
    </record>

</odoo>
