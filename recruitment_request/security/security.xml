<odoo>

    <record id="module_category_human_resources" model="ir.module.category">
        <field name="name">Human Resources</field>
        <field name="description">HR-related features</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_recruitment_manager" model="res.groups">
        <field name="name">Recruitment HR</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_recruitment_department_user" model="res.groups">
        <field name="name">Recruitment User</field>
        <field name="category_id" ref="module_category_human_resources"/>
    </record>


    <record id="group_recruitment_approver" model="res.groups">
        <field name="name">Recruitment Approver Manager</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="recruitment_request_visibility_rule" model="ir.rule">
        <field name="name">Show records only to assigned reporting manager</field>
        <field name="model_id" ref="model_hr_recruitment_request"/>
        <field name="domain_force">[('reporting_to_1', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="recruitment_request_visibility_rule_managers" model="ir.rule">
        <field name="name">Full visibility for Recruitment Managers</field>
        <field name="model_id" ref="model_hr_recruitment_request"/>
        <field name="domain_force">[(1, '=', 1)]</field> <!-- Always True: see all -->
        <field name="groups" eval="[(4, ref('recruitment_request.group_recruitment_manager'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>


    <record id="recruitment_request_visibility_rule_usersss" model="ir.rule">
        <field name="name">Full visibility for Recruitment Managers</field>
        <field name="model_id" ref="model_hr_recruitment_request"/>
        <field name="domain_force">[(1, '=', 1)]</field> <!-- Always True: see all -->
        <field name="groups" eval="[(4, ref('recruitment_request.group_recruitment_department_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>


    <record id="recruitment_request_visibility_rule_own" model="ir.rule">
        <field name="name">Own Recruitment Requests Only</field>
        <field name="model_id" ref="model_hr_recruitment_request"/>
        <field name="domain_force">[('requested_by', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>


    <record id="recruitment_request_admin_access_rule" model="ir.rule">
        <field name="name">Full Access for Admins</field>
        <field name="model_id" ref="model_hr_recruitment_request"/>
        <field name="domain_force">[(1, '=', 1)]</field> <!-- Always true -->
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <record id="hr_department_rule" model="ir.rule">
        <field name="name">Read All Departments for HR Group</field>
        <field name="model_id" ref="hr.model_hr_department"/>
        <field name="domain_force">[(1, '=', 1)]</field> <!-- Always True -->
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Security Rule: Only see records for your company -->
    <!-- Company-restricted Records -->
    <record model="ir.rule" id="record_restricted_company_rule">
        <field name="name">Restricted Record: multi-company</field>
        <field name="model_id" ref="model_hr_recruitment_request"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            [('company_id', 'in', company_ids)]
        </field>
    </record>


</odoo>
